import Truss.Transfer.Normalisation.SuccAssembly
import Truss.Transfer.Normalisation.ThinReflection

/-!
# Top normalisation as a reflection (§5.5)

This module formalises the reflection-based core of the draft normalisation chapter's §5.5,
rows `R2`–`R5` of
[the reflection plan](../../../plan/ReflectionNormalisationVerification.md).
Fix a labelled `(m+1)`-truss bundle `(T, L)` over `P`, and write

* `ν_T : (T_(m+1), L) → (T*_(m+1), L*)` for the fixed-base normalisation of its top labelled
  1-truss bundle over `T_m` (`B10`, `cons:draft-normalisation-labelled-open-1-bundles`),
* `χ*L := χ_(T*_(m+1), L*) : T_m → B(C)` for the classifier of its target,
* `τ_T := (id, ν_T) : (T, L) → (T, L)*` for the top normalisation,
* `P := OutCoarse(T, L)` and `Q := OutCoarse(T_(≤m), χ*L)`.

## Main definitions

* `succTopTarget`, `succTopMap`, `succClassifier` — `ν_T`, its target and `χ*L`
  (`def:draft-top-normalisation`).  These are the fixed-base normaliser of §5.4; they moved
  here from `RecursiveNorm.lean` unchanged.
* `appendTop` — the tower map `(id, c) : (T, L) → (T_(≤m) ⊕ D)` for a labelled map `c` of
  top bundles over `T_m`, built with the successor constructor of Chapter 2.
* `topNormObj`, `topNorm` — `(T, L)*` and `τ_T = (id, ν_T)`.
* `lowerObj` — `(T_(≤m), χ*L)`.
* `liftTarget`, `lift`, `liftMed` — the labelled lifting of
  `lem:draft-lifting-lower-labelled-coarsenings`, for an **arbitrary** top coarsening `c`.
* `phi`, `lam` — the functors `Φ : P → Q` and `Λ : Q → P` of
  `prop:draft-top-normalisation-reflection`, on **all** outgoing coarsenings.
* `unitHom` — the unit `R → Λ(Φ(R))`, i.e. `τ_U` read through the representative
  identification `(U, N)* = Λ(Φ(R))`-target.
* `reflection`, `lamFullyFaithful` — `Φ ⊣ Λ` and full faithfulness of `Λ`.

## Main results

* `topNorm_isCoarsening` — `τ_T` is a labelled coarsening.
* `topNorm_along_lower` — `lem:draft-top-normalisation-along-lower` (1):
  `(j^* ν_U) ∘ a = ν_T` in the chosen representatives.
* `succClassifier_along_lower` — `lem:draft-top-normalisation-along-lower` (2):
  `χ*L = χ*N ∘ j`.
* `lift_isCoarsening`, `lift_comp`, `lift_target_eq` — `lem:draft-lifting-lower-labelled-
  coarsenings`, with the composition law used for `Λ` on morphisms.
* `lam_comp_phi` — `Φ ∘ Λ = id_Q` as an **equality of functors**, including labels.
* `lam_phi_map` — the unit factorisation `Λ(Φ(R)) = τ_U ∘ R` (representative form).
* `lam_isNormalising_iff` — `Λ` preserves and reflects normalising coarsenings (terminal
  objects).

## What this module does *not* claim

The reflection is between the two outgoing categories of one **fixed** source.  No
normalisation functor on arbitrary bundle maps is defined, and `P` is the full category of
all labelled coarsenings out of `(T, L)`, not a subcategory generated by the algorithm.
Nothing here uses the inductive characterisation of normalising coarsenings, recursive
correctness, or any higher-dimensional normalisation existence.
-/

universe u v

namespace Truss.Transfer

open CategoryTheory TrussLike Limits

section TopNorm

variable {P : FPoset.{u}} {m : ℕ} {C : Type v} [Category.{v} C]

/-! ### R2: the top normaliser and its classifier -/

/-- **`def:draft-top-normalisation`, the target `(T*_(m+1), L*)`**: the normalisation of the
final labelled 1-truss bundle `(T_(m+1), L)` over `T_m`, supplied by `B10`. -/
noncomputable def succTopTarget (T : Tower P (m + 1))
    (L : (towerTot P (m + 1) T).carrier ⥤ C) :
    LabObj 1 (OpenBundle (towerTot P m T.lower).carrier) C :=
  OpenBundle.bundleNormalise (fibrewiseThm (towerTot P m T.lower).carrier) T.top L

/-- **`def:draft-top-normalisation`, the map `ν_T : (T_(m+1), L) → (T*_(m+1), L*)`.** -/
noncomputable def succTopMap (T : Tower P (m + 1))
    (L : (towerTot P (m + 1) T).carrier ⥤ C) :
    (⟨T.top, L⟩ : LabObj 1 (OpenBundle (towerTot P m T.lower).carrier) C) ⟶
      succTopTarget T L :=
  OpenBundle.bundleNormaliseMap (fibrewiseThm (towerTot P m T.lower).carrier) T.top L

/-- `ν_T` is normalising: this is `B10`. -/
theorem succTopMap_isNormalising (T : Tower P (m + 1))
    (L : (towerTot P (m + 1) T).carrier ⥤ C) : IsNormalising (succTopMap T L) :=
  OpenBundle.bundleNormaliseMap_isNormalising' T.top L

/-- **`def:draft-top-normalisation`, the classifier `χ*L := χ_(T*_(m+1), L*) : T_m → B(C)`**
of the target of `ν_T`. -/
noncomputable def succClassifier (T : Tower P (m + 1))
    (L : (towerTot P (m + 1) T).carrier ⥤ C) :
    (towerTot P m T.lower).carrier ⥤ LabOneTruss C :=
  OpenBundle.classify (succTopTarget T L).obj (succTopTarget T L).label

/-- The labelled `m`-truss bundle `(T_(≤m), χ*L)`, the source of the lower category `Q`. -/
noncomputable abbrev lowerObj (A : LabObj (m + 1) (Tower P (m + 1)) C) :
    LabObj m (Tower P m) (LabOneTruss C) :=
  ⟨A.obj.lower, succClassifier A.obj A.label⟩

/-! ### Appending a top map with identity lower part -/

/-- The labelled `(m+1)`-truss bundle obtained by appending a labelled 1-truss bundle over
`T_m` to the lower tower `T_(≤m)`. -/
def appendObj (V : Tower P m) (D : LabObj 1 (OpenBundle (towerTot P m V).carrier) C) :
    LabObj (m + 1) (Tower P (m + 1)) C :=
  ⟨V.succ D.obj, D.label⟩

/-- **`(id, c)`.**  A labelled map `c` of top bundles over `T_m` (base map the identity)
extends by the identity of `T_(≤m)` to a labelled map of `(m+1)`-towers.  This is the
successor constructor of `prop:structural-successor-equivalence`, with the identity
reindexing `id^* D = D` holding on the nose. -/
def appendTop (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D) : A ⟶ appendObj A.obj.lower D :=
  ⟨⟨TowerMap.id A.obj.lower, OrderHom.id, TowerMap.totHom_id _, c.1⟩, c.2⟩

@[simp] theorem appendTop_lower (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D) : (appendTop A c).1.lower = 𝟙 A.obj.lower := rfl

@[simp] theorem appendTop_base (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D) : (appendTop A c).1.base = OrderHom.id := rfl

@[simp] theorem appendTop_topMap (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D) : (appendTop A c).1.topMap = c.1 := rfl

/-- `(id, c)` is a coarsening whenever `c` is: `thm:draft-successor-coarsening`, `(3) → (1)`. -/
theorem appendTop_isCoarsening (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    {c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D} (hc : IsCoarsening c.1) : IsCoarsening (appendTop A c).1 :=
  isCoarsening_of_parts _ (IsCoarsening.id _) hc

/-- `(id, c) ≫ (id, c') = (id, c ≫ c')`. -/
theorem appendTop_comp (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D D' : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D) (c' : D ⟶ D') :
    appendTop A c ≫ appendTop (appendObj A.obj.lower D) c' = appendTop A (c ≫ c') := by
  refine Subtype.ext (TowerMap.ext_succ _ _ rfl ?_)
  simp only [eqToHom_refl, Category.comp_id]
  rfl

/-- `(id, id) = id`. -/
theorem appendTop_id (A : LabObj (m + 1) (Tower P (m + 1)) C) :
    appendTop A (𝟙 _) = 𝟙 A := rfl

/-- `(id, eqToHom) = eqToHom`: appending a representative identification of the top bundle is
the canonical comparison of the extended towers. -/
theorem appendTop_eqToHom (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (h : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      = D) :
    appendTop A (eqToHom h) = eqToHom (congrArg (appendObj A.obj.lower) h) := by
  subst h; rfl

/-- **`def:draft-top-normalisation`, `(T, L)*`**: `(T*_(m+1), L*)` appended to `T_(≤m)`. -/
noncomputable def topNormObj (A : LabObj (m + 1) (Tower P (m + 1)) C) :
    LabObj (m + 1) (Tower P (m + 1)) C :=
  appendObj A.obj.lower (succTopTarget A.obj A.label)

/-- **`def:draft-top-normalisation`, `τ_T := (id, ν_T) : (T, L) → (T, L)*`.** -/
noncomputable def topNorm (A : LabObj (m + 1) (Tower P (m + 1)) C) : A ⟶ topNormObj A :=
  appendTop A (succTopMap A.obj A.label)

/-- **Computation equations for `τ_T`**: lower part the identity, base map the identity,
top map `ν_T`. -/
theorem topNorm_lower (A : LabObj (m + 1) (Tower P (m + 1)) C) :
    (topNorm A).1.lower = 𝟙 A.obj.lower := rfl

theorem topNorm_base (A : LabObj (m + 1) (Tower P (m + 1)) C) :
    (topNorm A).1.base = OrderHom.id := rfl

theorem topNorm_topMap (A : LabObj (m + 1) (Tower P (m + 1)) C) :
    (topNorm A).1.topMap = (succTopMap A.obj A.label).1 := rfl

/-- **`def:draft-top-normalisation`: `τ_T` is a labelled coarsening**, by
`thm:draft-successor-coarsening`.  It is *not* asserted to normalise the whole tower. -/
theorem topNorm_isCoarsening (A : LabObj (m + 1) (Tower P (m + 1)) C) :
    IsCoarsening (topNorm A).1 :=
  appendTop_isCoarsening A (succTopMap_isNormalising A.obj A.label).1

/-! ### R3: top normalisation along arbitrary lower coarsenings -/

/-- **`lem:draft-top-normalisation-along-lower` (1).**  For every labelled coarsening
`R = (J, a) : (T, L) → (U, N)`, with `j = Tot(J)`,
`(j^* ν_U) ∘ a = ν_T` in the chosen representatives: the targets are **equal** and the maps
agree after the canonical identification.

The route is the printed one: `j` is a poset coarsening, hence open; open pullback preserves
normalisation (`B11`); postcomposition with a normalising map after a source that admits a
normalisation is normalising (`prop:draft-terminal-factors` (3)); and two normalising maps
out of one labelled 1-truss bundle are equal in the chosen representatives
(`OpenBundle.normalising_target_eq`, the labelled retained-family classification). -/
theorem topNorm_along_lower {A B : LabObj (m + 1) (Tower P (m + 1)) C} (R : A ⟶ B)
    (hR : IsCoarsening R.1) :
    ∃ e : succTopTarget A.obj A.label
        = ⟨OpenBundle.reindex R.1.base (succTopTarget B.obj B.label).obj,
           OpenBundle.pullbackLabel R.1.base (succTopTarget B.obj B.label).obj
             (succTopTarget B.obj B.label).label⟩,
      succTopMap A.obj A.label ≫ eqToHom e
        = topLab R ≫ OpenBundle.labReindex R.1.base (succTopMap B.obj B.label) := by
  have hopen : IsOpenPosetMap R.1.base := by
    rw [← TowerMap.base_eq R.1]; exact (isCoarsening_lower hR).tot.isOpen
  have hdj : IsNormalising (OpenBundle.labReindex R.1.base (succTopMap B.obj B.label)) :=
    OpenBundle.isNormalising_reindex' R.1.base hopen _ (succTopMap_isNormalising _ _)
  have hadj : IsNormalising
      (topLab R ≫ OpenBundle.labReindex R.1.base (succTopMap B.obj B.label)) :=
    (normalising_precomp (isCoarsening_topMap hR) hdj.1
      ⟨_, _, succTopMap_isNormalising A.obj A.label⟩).2 hdj
  exact OpenBundle.normalising_target_eq (succTopMap_isNormalising A.obj A.label) hadj

/-- **`lem:draft-top-normalisation-along-lower` (2).**  `χ*L = χ*N ∘ j`: the targets of the two
normalisations agree by clause (1), and classifiers of reindexed bundles are reindexed
classifiers (`classify_reindex`, `lem:recognising-reindexed-labelled-bundles` in the chosen
representatives). -/
theorem succClassifier_along_lower {A B : LabObj (m + 1) (Tower P (m + 1)) C} (R : A ⟶ B)
    (hR : IsCoarsening R.1) :
    succClassifier A.obj A.label
      = posetFunctor R.1.base ⋙ succClassifier B.obj B.label := by
  obtain ⟨e, -⟩ := topNorm_along_lower R hR
  have hz := congrArg (fun z : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C =>
    OpenBundle.classify z.obj z.label) e
  simp only [classify_reindex] at hz
  exact hz

/-- **`lem:draft-top-normalisation-along-lower` (2), labelled form.**  The lower component
`J` of a labelled coarsening `R` is a labelled map
`(T_(≤m), χ*L) → (U_(≤m), χ*N)`. -/
noncomputable def phiHom {A B : LabObj (m + 1) (Tower P (m + 1)) C} (R : A ⟶ B)
    (hR : IsCoarsening R.1) : lowerObj A ⟶ lowerObj B :=
  ⟨R.1.lower, (succClassifier_along_lower R hR).trans (by rw [← TowerMap.base_eq R.1])⟩

@[simp] theorem phiHom_coe {A B : LabObj (m + 1) (Tower P (m + 1)) C} (R : A ⟶ B)
    (hR : IsCoarsening R.1) : (phiHom R hR).1 = R.1.lower := rfl

/-! ### R4: lifting lower labelled coarsenings -/

/-- **`lem:draft-lifting-lower-labelled-coarsenings`: the extension's top bundle has
classifying functor `Ĥ`.** -/
theorem classify_liftTarget (Y : LabObj m (Tower P m) (LabOneTruss C)) :
    OpenBundle.classify (totaliseBundle Y.label) (totaliseLabel Y.label) = Y.label :=
  classify_totaliseBundle Y.label

/-- The extension `(U, H)` of a labelled lower tower `(U_(≤m), Ĥ)`: totalise `Ĥ` and append
it.  Open values of `Ĥ` are automatic here, since `B(C) = LabOneTruss C` consists of *open*
labelled 1-trusses (see the coverage ledger, row `R4`). -/
noncomputable def liftTarget (Y : LabObj m (Tower P m) (LabOneTruss C)) :
    LabObj (m + 1) (Tower P (m + 1)) C :=
  appendObj Y.obj (labTotalise Y.label)

/-- **`lem:draft-lifting-lower-labelled-coarsenings`, the target identification.**  If
`J : (T_(≤m), χ_(D)) → (U_(≤m), Ĥ)` is a labelled map, then `D = j^*(U_(m+1), H)` in the
chosen representatives: `lem:recognising-reindexed-labelled-bundles` in its strict form
(`labTotalise_comp`, `labTotalise_classify`). -/
theorem lift_target_eq (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    {Y : LabObj m (Tower P m) (LabOneTruss C)}
    (J : (⟨A.obj.lower, OpenBundle.classify D.obj D.label⟩ :
      LabObj m (Tower P m) (LabOneTruss C)) ⟶ Y) :
    D = ⟨OpenBundle.reindex (J.1 : A.obj.lower ⟶ Y.obj).totHom (labTotalise Y.label).obj,
      OpenBundle.pullbackLabel (J.1 : A.obj.lower ⟶ Y.obj).totHom (labTotalise Y.label).obj
        (labTotalise Y.label).label⟩ := by
  have h := congrArg labTotalise J.2
  rw [labTotalise_comp, labTotalise_classify] at h
  exact h

/-- **`lem:draft-lifting-lower-labelled-coarsenings`, the lift `(J, c)`.**  For **any**
labelled map `c : (T_(m+1), L) → D` of top bundles over `T_m`, and any labelled lower map
`J : (T_(≤m), χ_D) → (U_(≤m), Ĥ)`, the pair `(J, c)` is a labelled map of `(m+1)`-towers into
the extension `(U, H)`.  No normalising hypothesis on `c` is made. -/
noncomputable def lift (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D)
    {Y : LabObj m (Tower P m) (LabOneTruss C)}
    (J : (⟨A.obj.lower, OpenBundle.classify D.obj D.label⟩ :
      LabObj m (Tower P m) (LabOneTruss C)) ⟶ Y) : A ⟶ liftTarget Y :=
  assemble (L := A.label) J.1 (c ≫ eqToHom (lift_target_eq A J))

/-- Computation equations for the lift: lower part `J`, base map `j`, top map `c`
(transported along `lift_target_eq`). -/
@[simp] theorem lift_lower (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D)
    {Y : LabObj m (Tower P m) (LabOneTruss C)}
    (J : (⟨A.obj.lower, OpenBundle.classify D.obj D.label⟩ :
      LabObj m (Tower P m) (LabOneTruss C)) ⟶ Y) : (lift A c J).1.lower = J.1 := rfl

@[simp] theorem lift_base (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D)
    {Y : LabObj m (Tower P m) (LabOneTruss C)}
    (J : (⟨A.obj.lower, OpenBundle.classify D.obj D.label⟩ :
      LabObj m (Tower P m) (LabOneTruss C)) ⟶ Y) :
    (lift A c J).1.base = (J.1 : A.obj.lower ⟶ Y.obj).totHom := rfl

theorem lift_topMap (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D)
    {Y : LabObj m (Tower P m) (LabOneTruss C)}
    (J : (⟨A.obj.lower, OpenBundle.classify D.obj D.label⟩ :
      LabObj m (Tower P m) (LabOneTruss C)) ⟶ Y) :
    (lift A c J).1.topMap = c.1 ≫ eqToHom (congrArg LabObj.obj (lift_target_eq A J)) := by
  change (c ≫ eqToHom (lift_target_eq A J)).1 = _
  rw [LabObj.comp_coe, LabObj.eqToHom_coe]

/-- **`lem:draft-lifting-lower-labelled-coarsenings`: `j` is surjective**, since `J` is a
coarsening (`def:draft-coarsening`). -/
theorem lift_base_surjective (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    {Y : LabObj m (Tower P m) (LabOneTruss C)}
    {J : (⟨A.obj.lower, OpenBundle.classify D.obj D.label⟩ :
      LabObj m (Tower P m) (LabOneTruss C)) ⟶ Y} (hJ : IsCoarsening J.1) :
    Function.Surjective (J.1 : A.obj.lower ⟶ Y.obj).totHom :=
  hJ.tot.surjective

/-- **`lem:draft-lifting-lower-labelled-coarsenings`: the lift is a labelled coarsening**
when `c` and `J` are, by `thm:draft-successor-coarsening`, `(3) → (1)`. -/
theorem lift_isCoarsening (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    {c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D}
    {Y : LabObj m (Tower P m) (LabOneTruss C)}
    {J : (⟨A.obj.lower, OpenBundle.classify D.obj D.label⟩ :
      LabObj m (Tower P m) (LabOneTruss C)) ⟶ Y} (hc : IsCoarsening c.1)
    (hJ : IsCoarsening J.1) : IsCoarsening (lift A c J).1 :=
  isCoarsening_of_parts _ hJ (hc.comp (isCoarsening_labEqToHom _))

/-- The identification `(U_(m+1), H) = k^*(U'_(m+1), H')` carried by a labelled lower map
`K : (U_(≤m), Ĥ) → (U'_(≤m), Ĥ')`. -/
theorem liftMed_eq {Y Y' : LabObj m (Tower P m) (LabOneTruss C)} (K : Y ⟶ Y') :
    labTotalise Y.label
      = ⟨OpenBundle.reindex (K.1 : Y.obj ⟶ Y'.obj).totHom (labTotalise Y'.label).obj,
        OpenBundle.pullbackLabel (K.1 : Y.obj ⟶ Y'.obj).totHom (labTotalise Y'.label).obj
          (labTotalise Y'.label).label⟩ := by
  have h := congrArg labTotalise K.2
  rw [labTotalise_comp] at h
  exact h

/-- **The lift of a lower mediator `K` with top component the identity**, `(K, id)`. -/
noncomputable def liftMed {Y Y' : LabObj m (Tower P m) (LabOneTruss C)} (K : Y ⟶ Y') :
    liftTarget Y ⟶ liftTarget Y' :=
  assemble (T := (liftTarget Y).obj) (L := (liftTarget Y).label) K.1 (eqToHom (liftMed_eq K))

/-- `(K, id)` is a coarsening whenever `K` is. -/
theorem liftMed_isCoarsening {Y Y' : LabObj m (Tower P m) (LabOneTruss C)} {K : Y ⟶ Y'}
    (hK : IsCoarsening K.1) : IsCoarsening (liftMed K).1 :=
  isCoarsening_of_parts _ hK (isCoarsening_labEqToHom _)

/-- The top map of a composite of `(m+1)`-tower maps: `(Q ≫ R)_top = Q_top ≫ q^* R_top`
(`def:bundle-over-structural-tower`, composition). -/
theorem TowerMap.comp_topMap {T S U : Tower P (m + 1)} (Q : T ⟶ S) (R : S ⟶ U) :
    @Eq (T.top ⟶ OpenBundle.reindex Q.base (OpenBundle.reindex R.base U.top))
      (TowerMap.topMap (Q ≫ R))
      ((Q.topMap : T.top ⟶ OpenBundle.reindex Q.base S.top)
        ≫ (BundleMap.reindex Q.base R.topMap :
            OpenBundle.reindex Q.base S.top ⟶ OpenBundle.reindex Q.base
              (OpenBundle.reindex R.base U.top))) := rfl

/-- Reindexing the canonical comparison of equal bundles gives the canonical comparison of the
reindexed bundles; the form of `BundleMap.reindex_eqToHom` that `rw` can match. -/
theorem BundleMap.reindex_eqToHom'' {B B' : Type u} [PartialOrder B] [PartialOrder B']
    [Finite B] [Finite B'] (f : B' →o B) {A A' : OpenBundle B} (h : A = A') :
    @Eq (OpenBundle.reindex f A ⟶ OpenBundle.reindex f A')
      (BundleMap.reindex f (eqToHom h)) (eqToHom (congrArg (OpenBundle.reindex f) h)) := by
  subst h; rfl

/-- **Composition law for lifts** (`def:bundle-over-structural-tower`):
`(J ≫ K, c) = (J, c) ≫ (K, id)`. -/
theorem lift_comp (A : LabObj (m + 1) (Tower P (m + 1)) C)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D)
    {Y Y' : LabObj m (Tower P m) (LabOneTruss C)}
    (J : (⟨A.obj.lower, OpenBundle.classify D.obj D.label⟩ :
      LabObj m (Tower P m) (LabOneTruss C)) ⟶ Y) (K : Y ⟶ Y') :
    lift A c (J ≫ K) = lift A c J ≫ liftMed K := by
  refine Subtype.ext (TowerMap.ext_succ _ _ (by exact TowerMap.totHom_comp J.1 K.1) ?_)
  refine Eq.trans ?_ (TowerMap.comp_topMap (lift A c J).1 (liftMed K).1).symm
  have hK : (liftMed K).1.topMap = eqToHom (congrArg LabObj.obj (liftMed_eq K)) := by
    change (eqToHom (liftMed_eq K)).1 = _
    rw [LabObj.eqToHom_coe]
  rw [lift_topMap, lift_topMap, hK, BundleMap.reindex_eqToHom'']
  simp only [Category.assoc, eqToHom_trans]

/-! ### Comparing a lift with a composite `R ≫ (id, d)` -/

/-- **The representative-level comparison behind the unit and the inductive criterion.**
Let `R : A → B` be a labelled map, `c` a labelled top map out of `(T_(m+1), L)`, `J` a lower
labelled map whose underlying map is the lower part of `R`, and `d` a labelled top map out of
`(B_(m+1), N)` into the totalisation of a label `Ĥ` on `B_(≤m)`.  If
`c = (r^* d) ∘ topLab(R)` in the chosen representatives, then the lift `(J, c)` **equals**
`(id, d) ∘ R`. -/
theorem lift_eq_comp_appendTop {A B : LabObj (m + 1) (Tower P (m + 1)) C} (R : A ⟶ B)
    {D : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C}
    (c : (⟨A.obj.top, A.label⟩ : LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)
      ⟶ D)
    {H : (towerTot P m B.obj.lower).carrier ⥤ LabOneTruss C}
    (J : (⟨A.obj.lower, OpenBundle.classify D.obj D.label⟩ :
      LabObj m (Tower P m) (LabOneTruss C)) ⟶ ⟨B.obj.lower, H⟩) (hJ : J.1 = R.1.lower)
    (d : (⟨B.obj.top, B.label⟩ : LabObj 1 (OpenBundle (towerTot P m B.obj.lower).carrier) C)
      ⟶ labTotalise H)
    (e : D = ⟨OpenBundle.reindex R.1.base (labTotalise H).obj,
        OpenBundle.pullbackLabel R.1.base (labTotalise H).obj (labTotalise H).label⟩)
    (he : c ≫ eqToHom e = topLab R ≫ OpenBundle.labReindex R.1.base d) :
    lift A c J = R ≫ appendTop B d := by
  have hb : (lift A c J).1.base = (R ≫ appendTop B d).1.base := by
    change (J.1 : A.obj.lower ⟶ B.obj.lower).totHom = R.1.base
    rw [hJ]; exact TowerMap.base_eq R.1
  refine Subtype.ext (TowerMap.ext_succ _ _ hb ?_)
  refine Eq.trans ?_ (TowerMap.comp_topMap R.1 (appendTop B d).1).symm
  have h1 := congrArg Subtype.val he
  simp only [LabObj.comp_coe, topLab_coe, OpenBundle.labReindex_coe,
    LabObj.eqToHom_coe] at h1
  rw [lift_topMap, appendTop_topMap, ← h1]
  simp only [Category.assoc, eqToHom_trans]

end TopNorm

/-! ### R5: the reflection -/

section Reflection

variable {P : FPoset.{u}} {m : ℕ} {C : Type v} [Category.{v} C]

/-- Two objects of `OutCoarse(X, L)` with equal targets and (heterogeneously) equal
underlying maps are equal. -/
theorem LabOutCoarse.ext_of_heq {n : ℕ} {K : Type u} [Category.{u} K] [TrussLike.{u, u, u} n K]
    {A : LabObj n K C} {r s : LabOutCoarse A} (h : r.tgt = s.tgt)
    (hm : HEq r.map.1 s.map.1) : r = s := by
  obtain ⟨rt, rm, rc⟩ := r
  obtain ⟨st, sm, sc⟩ := s
  dsimp only at h hm
  subst h
  obtain rfl : rm = sm := Subtype.ext (eq_of_heq hm)
  rfl

variable (A : LabObj (m + 1) (Tower P (m + 1)) C)

/-- **`prop:draft-top-normalisation-reflection`, `Φ : P → Q`.**  `Φ(R) := J`, the lower
component of `R = (J, a) : (T, L) → (U, N)`, as a labelled coarsening
`(T_(≤m), χ*L) → (U_(≤m), χ*N)`.  On morphisms, the lower component of a mediator. -/
noncomputable def phi : LabOutCoarse A ⥤ LabOutCoarse (lowerObj A) where
  obj R := ⟨lowerObj R.tgt, phiHom R.map R.isCoarsening, isCoarsening_lower R.isCoarsening⟩
  map {_ R'} h := ⟨phiHom h.1 h.2.1, isCoarsening_lower h.2.1,
    Subtype.ext (congrArg (fun z : A ⟶ R'.tgt => z.1.lower) h.2.2)⟩
  map_id _ := Subsingleton.elim _ _
  map_comp _ _ := Subsingleton.elim _ _

/-- **`prop:draft-top-normalisation-reflection`, `Λ : Q → P`.**  `Λ(J) := (J, ν_T)`, the lift of
`lem:draft-lifting-lower-labelled-coarsenings` with `c = ν_T`; on morphisms `K ↦ (K, id)`. -/
noncomputable def lam : LabOutCoarse (lowerObj A) ⥤ LabOutCoarse A where
  obj J := ⟨liftTarget J.tgt, lift A (succTopMap A.obj A.label) J.map,
    lift_isCoarsening A (succTopMap_isNormalising A.obj A.label).1 J.isCoarsening⟩
  map K := ⟨liftMed K.1, liftMed_isCoarsening K.2.1,
    (congrArg (lift A (succTopMap A.obj A.label)) K.2.2).trans (lift_comp _ _ _ _)⟩
  map_id _ := Subsingleton.elim _ _
  map_comp _ _ := Subsingleton.elim _ _

/-- The object part of `Λ`: target `(U, H)` and map `(J, ν_T)`. -/
@[simp] theorem lam_obj_tgt (J : LabOutCoarse (lowerObj A)) :
    ((lam A).obj J).tgt = liftTarget J.tgt := rfl

@[simp] theorem lam_obj_map (J : LabOutCoarse (lowerObj A)) :
    ((lam A).obj J).map = lift A (succTopMap A.obj A.label) J.map := rfl

/-- **The label computation `χ*(H) = Ĥ` for a lifted target.**  Applying
`lem:draft-top-normalisation-along-lower` (2) to `Λ(J)` gives `χ*(H) ∘ j = χ*L = Ĥ ∘ j`, and
precomposition with the poset coarsening `j` is injective (`label_descent_unique`:
surjectivity on objects **and** arrows, `lem:draft-poset-coarsening-basics`). -/
theorem succClassifier_liftTarget (J : LabOutCoarse (lowerObj A)) :
    succClassifier (liftTarget J.tgt).obj (liftTarget J.tgt).label = J.tgt.label := by
  have h1 := succClassifier_along_lower ((lam A).obj J).map ((lam A).obj J).isCoarsening
  have h2 : succClassifier A.obj A.label
      = posetFunctor (J.map.1 : A.obj.lower ⟶ J.tgt.obj).totHom ⋙ J.tgt.label := J.map.2
  refine label_descent_unique J.isCoarsening.tot ?_
  exact h1.symm.trans h2

/-- **`prop:draft-top-normalisation-reflection`: `Φ ∘ Λ = id_Q`**, as an equality of
functors (Lean's `Λ ⋙ Φ = 𝟭`), including target labellings.  On morphisms it holds by
thinness of `Q`. -/
theorem lam_comp_phi : lam A ⋙ phi A = 𝟭 (LabOutCoarse (lowerObj A)) := by
  refine CategoryTheory.Functor.ext (fun J => ?_) (fun _ _ _ => Subsingleton.elim _ _)
  refine LabOutCoarse.ext_of_heq ?_ HEq.rfl
  change (⟨J.tgt.obj, succClassifier (liftTarget J.tgt).obj (liftTarget J.tgt).label⟩ :
    LabObj m (Tower P m) (LabOneTruss C)) = J.tgt
  rw [succClassifier_liftTarget]

/-- The representative identification `(U, N)* = Λ(Φ(R))`-target, i.e. `ν_U` followed by
`(U*_(m+1), N*) = π(χ(U*_(m+1), N*))`. -/
noncomputable def unitTop (B : LabObj (m + 1) (Tower P (m + 1)) C) :
    (⟨B.obj.top, B.label⟩ : LabObj 1 (OpenBundle (towerTot P m B.obj.lower).carrier) C) ⟶
      labTotalise (succClassifier B.obj B.label) :=
  succTopMap B.obj B.label ≫ eqToHom (labTotalise_classify _ _).symm

/-- Reindexing the canonical comparison of equal labelled 1-truss bundles. -/
theorem labReindex_eqToHom {B B' : Type u} [PartialOrder B] [PartialOrder B'] [Finite B]
    [Finite B'] (f : B' →o B) {X X' : LabObj 1 (OpenBundle B) C} (h : X = X') :
    OpenBundle.labReindex f (eqToHom h : (⟨X.obj, X.label⟩ : LabObj 1 (OpenBundle B) C) ⟶
        ⟨X'.obj, X'.label⟩)
      = eqToHom (congrArg (fun Z : LabObj 1 (OpenBundle B) C =>
          (⟨OpenBundle.reindex f Z.obj, OpenBundle.pullbackLabel f Z.obj Z.label⟩ :
            LabObj 1 (OpenBundle B') C)) h) := by
  subst h; rfl

/-- **`prop:draft-top-normalisation-reflection`, the unit factorisation**
`Λ(Φ(R)) = τ_U ∘ R` in the chosen representatives: the lift `(J, ν_T)` equals `R` followed
by `(id, ν_U)`, read through `(U, N)* = Λ(Φ(R))`-target.  This is
`lem:draft-top-normalisation-along-lower` (1) combined with the composition law of
`def:bundle-over-structural-tower`. -/
theorem lam_phi_map (R : LabOutCoarse A) :
    ((lam A).obj ((phi A).obj R)).map = R.map ≫ appendTop R.tgt (unitTop R.tgt) := by
  obtain ⟨e₀, he₀⟩ := topNorm_along_lower R.map R.isCoarsening
  have hcl := (labTotalise_classify (succTopTarget R.tgt.obj R.tgt.label).obj
    (succTopTarget R.tgt.obj R.tgt.label).label).symm
  refine lift_eq_comp_appendTop R.map _ _ rfl _
    (e₀.trans (congrArg (fun Z : LabObj 1 (OpenBundle
        (towerTot P m R.tgt.obj.lower).carrier) C =>
      (⟨OpenBundle.reindex R.map.1.base Z.obj,
        OpenBundle.pullbackLabel R.map.1.base Z.obj Z.label⟩ :
          LabObj 1 (OpenBundle (towerTot P m A.obj.lower).carrier) C)) hcl)) ?_
  have hsplit : OpenBundle.labReindex R.map.1.base (unitTop R.tgt)
      = OpenBundle.labReindex R.map.1.base (succTopMap R.tgt.obj R.tgt.label)
        ≫ OpenBundle.labReindex R.map.1.base (eqToHom hcl) := rfl
  rw [hsplit, labReindex_eqToHom, ← Category.assoc, ← he₀, Category.assoc, eqToHom_trans]

/-- **The unit is `τ_U`**: as a labelled map it is the top normalisation `τ_U = (id, ν_U)`
followed by the canonical comparison `(U, N)* = Λ(Φ(R))`-target, i.e. `τ_U` in the chosen
representatives. -/
theorem unitTop_appendTop_eq (B : LabObj (m + 1) (Tower P (m + 1)) C) :
    appendTop B (unitTop B) = topNorm B ≫ eqToHom (congrArg (appendObj B.obj.lower)
      (labTotalise_classify (succTopTarget B.obj B.label).obj
        (succTopTarget B.obj B.label).label).symm) := by
  rw [unitTop, ← appendTop_comp, appendTop_eqToHom]
  rfl

/-- **The unit `τ_U : R → Λ(Φ(R))`**, as a morphism of `P`: the top normalisation `τ_U` of
the target, read through the representative identification. -/
noncomputable def unitHom (R : LabOutCoarse A) : R ⟶ (lam A).obj ((phi A).obj R) :=
  ⟨appendTop R.tgt (unitTop R.tgt),
    appendTop_isCoarsening R.tgt
      ((succTopMap_isNormalising _ _).1.comp (isCoarsening_labEqToHom _)),
    lam_phi_map A R⟩

/-- **`prop:draft-top-normalisation-reflection`: `Φ ⊣ Λ`**, by `lem:draft-thin-reflection`.
The unit is `unitHom`. -/
noncomputable def reflection : phi A ⊣ lam A :=
  ThinReflection.adjunction (phi A) (lam A) (lam_comp_phi A) (unitHom A)

/-- **`prop:draft-top-normalisation-reflection`: `Λ` is fully faithful.** -/
noncomputable def lamFullyFaithful : (lam A).FullyFaithful :=
  ThinReflection.fullyFaithful (phi A) (lam A) (lam_comp_phi A)

/-- **`Λ` preserves and reflects terminal objects**, in the categorical form. -/
theorem lam_nonempty_isTerminal_iff (J : LabOutCoarse (lowerObj A)) :
    Nonempty (IsTerminal ((lam A).obj J)) ↔ Nonempty (IsTerminal J) :=
  ThinReflection.nonempty_isTerminal_obj_iff (phi A) (lam A) (lam_comp_phi A) (unitHom A) J

/-- **`Λ` preserves and reflects normalising coarsenings**: for a lower labelled coarsening
`F : (T_(≤m), χ*L) → (S_(≤m), Ĥ)`, the lift `(F, ν_T)` is normalising iff `F` is. -/
theorem lam_isNormalising_iff (J : LabOutCoarse (lowerObj A)) :
    IsNormalising ((lam A).obj J).map ↔ IsNormalising J.map := by
  rw [LabOutCoarse.isNormalising_iff_nonempty_isTerminal,
    LabOutCoarse.isNormalising_iff_nonempty_isTerminal, lam_nonempty_isTerminal_iff]

end Reflection

end Truss.Transfer
