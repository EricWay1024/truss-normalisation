import Mathlib.Order.Category.FinPartOrd
import Mathlib.Data.Fin.Basic
import Mathlib.Order.Hom.Basic
import Mathlib.Tactic.Linarith

/-!
# Chapter 2's coordinate model of a 1-truss (G01–G03)

This module formalises the 1-truss material of `dphil-notes-typst/transfer/ch02-trusses.typ`
that the draft normalisation chapter's §5.3 depends on: rows `G01`, `G02` and `G03` of
[`plan/DraftNormalisationVerification.md`](../../../plan/DraftNormalisationVerification.md).

Chapter 2 gives the *coordinate* description, and that is what is formalised here:

> `carrier := [n]`; `dim : [n] → [2]` with `dim 0 = ε` and `dim (i+1) = 1 - dim i`;
> frame order `i ⪯ j ↔ i ≤ j`; face order generated by `i ⊴ j` whenever `dim i = 1`,
> `dim j = 0` and `|i - j| = 1`; lower endpoint `ℓ := 0`, upper endpoint `u := n - 1`.

The chapter's brackets count elements, so `[n]` has `n` elements.  A 1-truss has a nonempty
carrier (it has endpoints), so the carrier is `Fin (len + 1)`.

## Main definitions

* `OneTruss` — the pair `(len, eps)`; `OneTruss.El` is the carrier `[len + 1]`.
* `OneTruss.dim`, `IsSingular`, `IsRegular` — `def:sing-reg`.
* the face order on `OneTruss.El`, with `OneTruss.idx` recovering the frame coordinate.
* `OneTruss.IsOpen`, `IsClosed`, `IsTrivial` — `Endpoint type`.
* `TrussMap` — `def:truss-map`, with identities and composition.

## Main results

* `OneTruss.faceLE_iff` and the `PartialOrder` instance — the "generated" face order is
  already the reflexive closure of the displayed covering relation, because a nonidentity
  face comparison runs from dimension `1` to dimension `0` and therefore never composes.
* `TrussMap.surjective_iff_endpoints` — `lem:truss-map-surjective-iff-endpoints` (G03), for
  **all** 1-trusses and with no regularity hypothesis.

## Relation to the intrinsic `Truss.OneTruss` library

The agreement of this coordinate model with the repository's intrinsic `Truss.OneTruss` is a
separate obligation (plan row `G01`, "agreement with intrinsic `OneTruss`") and is **OPEN**;
nothing here depends on it.
-/

namespace Truss.Transfer.Geometry

/-! ### G01: the coordinate model -/

/-- **Source: `def:one-truss` (Chapter 2).**  A 1-truss in the chapter's coordinate model.
`len + 1` is the chapter's `n`, i.e. the number of elements of the carrier `[n]`, and `eps`
is the dimension of the element `0`. -/
structure OneTruss where
  /-- One less than the number of carrier elements. -/
  len : ℕ
  /-- The dimension `ε` of the element `0`. -/
  eps : Fin 2

namespace OneTruss

/-- Every element of `[2]` is `0` or `1`. -/
theorem eq_zero_or_one (e : Fin 2) : e = 0 ∨ e = 1 := by revert e; decide

/-- Flip a dimension: `1 - e` in `[2]`. -/
def flip (e : Fin 2) : Fin 2 := if e = 0 then 1 else 0

@[simp] theorem flip_flip (e : Fin 2) : flip (flip e) = e := by revert e; decide

@[simp] theorem flip_eq_zero {e : Fin 2} : flip e = 0 ↔ e = 1 := by revert e; decide

@[simp] theorem flip_eq_one {e : Fin 2} : flip e = 1 ↔ e = 0 := by revert e; decide

theorem flip_ne (e : Fin 2) : flip e ≠ e := by revert e; decide

/-- The carrier `[n]` of a 1-truss, with the **face** order (see the `PartialOrder` instance
below).  The frame coordinate is recovered by `OneTruss.idx`. -/
def El (T : OneTruss) : Type := Fin (T.len + 1)

instance (T : OneTruss) : DecidableEq T.El := inferInstanceAs (DecidableEq (Fin _))

instance (T : OneTruss) : Fintype T.El := inferInstanceAs (Fintype (Fin _))

instance (T : OneTruss) : Nonempty T.El := inferInstanceAs (Nonempty (Fin (T.len + 1)))

/-- The frame coordinate of an element: the underlying index in `[n]`, carrying the chapter's
frame order `i ⪯ j ↔ i ≤ j`. -/
def idx {T : OneTruss} (i : T.El) : Fin (T.len + 1) := i

/-- An element of the carrier, from its frame coordinate. -/
def ofIdx {T : OneTruss} (i : Fin (T.len + 1)) : T.El := i

@[simp] theorem idx_ofIdx {T : OneTruss} (i : Fin (T.len + 1)) : idx (ofIdx (T := T) i) = i := rfl

@[simp] theorem ofIdx_idx {T : OneTruss} (i : T.El) : ofIdx (idx i) = i := rfl

theorem idx_injective {T : OneTruss} : Function.Injective (idx (T := T)) := fun _ _ h => h

/-- **Source: `def:one-truss`, dimension.**  `dim 0 = ε` and `dim (i+1) = 1 - dim i`, solved
in closed form: the dimension alternates with the parity of the index. -/
def dim (T : OneTruss) (i : T.El) : Fin 2 := if (idx i).val % 2 = 0 then T.eps else flip T.eps

@[simp] theorem dim_zero (T : OneTruss) : T.dim (ofIdx 0) = T.eps := by simp [dim, idx, ofIdx]

/-- The defining recursion of `dim`. -/
theorem dim_succ (T : OneTruss) (i j : T.El) (h : (idx j).val = (idx i).val + 1) :
    T.dim j = flip (T.dim i) := by
  simp only [dim, h]
  rcases Nat.even_or_odd (idx i).val with he | ho
  · have h0 : (idx i).val % 2 = 0 := Nat.even_iff.1 he
    rw [if_neg (by omega : ¬ ((idx i).val + 1) % 2 = 0), if_pos h0]
  · have h0 : (idx i).val % 2 = 1 := Nat.odd_iff.1 ho
    rw [if_pos (by omega : ((idx i).val + 1) % 2 = 0), if_neg (by omega), flip_flip]

/-- Two carrier elements whose indices differ by one have different dimensions. -/
theorem dim_ne_of_succ (T : OneTruss) {i j : T.El} (h : (idx j).val = (idx i).val + 1) :
    T.dim j ≠ T.dim i := by rw [dim_succ T i j h]; exact flip_ne _

/-- **Source: `def:sing-reg`.**  Singular elements are those of dimension `0`. -/
def IsSingular (T : OneTruss) (i : T.El) : Prop := T.dim i = 0

/-- **Source: `def:sing-reg`.**  Regular elements are those of dimension `1`. -/
def IsRegular (T : OneTruss) (i : T.El) : Prop := T.dim i = 1

theorem isSingular_or_isRegular (T : OneTruss) (i : T.El) : T.IsSingular i ∨ T.IsRegular i :=
  eq_zero_or_one (T.dim i)

theorem not_isSingular_iff (T : OneTruss) (i : T.El) : ¬ T.IsSingular i ↔ T.IsRegular i := by
  unfold IsSingular IsRegular
  rcases eq_zero_or_one (T.dim i) with h | h <;> rw [h] <;> simp

/-! ### The face order -/

/-- **Source: `def:one-truss`, face order.**  The relation generated by `i ⊴ j` whenever
`dim i = 1`, `dim j = 0` and `|i - j| = 1`.  The reflexive closure of that covering relation
is already transitive: a nonidentity comparison runs from dimension `1` to dimension `0`, so
two of them never compose. -/
def FaceLE (T : OneTruss) (i j : T.El) : Prop :=
  i = j ∨ (T.dim i = 1 ∧ T.dim j = 0 ∧
    ((idx i).val = (idx j).val + 1 ∨ (idx j).val = (idx i).val + 1))

theorem FaceLE.refl {T : OneTruss} (i : T.El) : T.FaceLE i i := Or.inl rfl

theorem FaceLE.trans {T : OneTruss} {i j k : T.El} (h₁ : T.FaceLE i j) (h₂ : T.FaceLE j k) :
    T.FaceLE i k := by
  rcases h₁ with rfl | ⟨hi, hj, _⟩
  · exact h₂
  · rcases h₂ with rfl | ⟨hj', _, _⟩
    · exact Or.inr ⟨hi, hj, by assumption⟩
    · rw [hj] at hj'; exact absurd hj' (by decide)

theorem FaceLE.antisymm {T : OneTruss} {i j : T.El} (h₁ : T.FaceLE i j) (h₂ : T.FaceLE j i) :
    i = j := by
  rcases h₁ with h | ⟨hi, hj, _⟩
  · exact h
  · rcases h₂ with h | ⟨hj', _, _⟩
    · exact h.symm
    · rw [hj] at hj'; exact absurd hj' (by decide)

instance (T : OneTruss) : PartialOrder T.El where
  le := T.FaceLE
  le_refl := FaceLE.refl
  le_trans _ _ _ := FaceLE.trans
  le_antisymm _ _ h₁ h₂ := FaceLE.antisymm h₁ h₂

theorem le_iff_faceLE {T : OneTruss} {i j : T.El} : i ≤ j ↔ T.FaceLE i j := Iff.rfl

/-- A nonidentity face comparison runs from a regular element to an adjacent singular one. -/
theorem lt_iff {T : OneTruss} {i j : T.El} :
    i < j ↔ (T.dim i = 1 ∧ T.dim j = 0 ∧
      ((idx i).val = (idx j).val + 1 ∨ (idx j).val = (idx i).val + 1)) := by
  constructor
  · intro h
    rcases h.le with heq | hc
    · exact absurd heq h.ne
    · exact hc
  · intro h
    refine lt_of_le_of_ne (Or.inr h) (fun heq => ?_)
    rw [heq, h.2.1] at h
    exact absurd h.1 (by decide)

/-- Distinct face-comparable elements have adjacent frame coordinates. -/
theorem idx_adjacent_of_lt {T : OneTruss} {i j : T.El} (h : i < j) :
    (idx i).val = (idx j).val + 1 ∨ (idx j).val = (idx i).val + 1 := (lt_iff.1 h).2.2

/-- Comparable elements differ in index by at most one. -/
theorem idx_dist_le_one {T : OneTruss} {i j : T.El} (h : i ≤ j ∨ j ≤ i) :
    ((idx i).val : ℤ) - (idx j).val ≤ 1 ∧ ((idx j).val : ℤ) - (idx i).val ≤ 1 := by
  rcases h with h | h <;> rcases h with rfl | ⟨_, _, hadj⟩ <;> omega

/-! ### Adjacent carrier elements are face-comparable -/

/-- Two carrier elements at adjacent frame coordinates are face-comparable: their dimensions
differ, so one is regular and the other singular. -/
theorem faceComparable_of_succ (T : OneTruss) {i j : T.El} (h : (idx j).val = (idx i).val + 1) :
    i ≤ j ∨ j ≤ i := by
  have hne := dim_ne_of_succ T h
  rcases isSingular_or_isRegular T i with hi | hi
  · -- `i` singular, so `j` is regular and `j ⊴ i`
    right
    refine Or.inr ⟨?_, hi, Or.inl h⟩
    rcases isSingular_or_isRegular T j with hj | hj
    · exact absurd (hj.trans hi.symm) hne
    · exact hj
  · -- `i` regular, so `j` is singular and `i ⊴ j`
    left
    refine Or.inr ⟨hi, ?_, Or.inr h⟩
    rcases isSingular_or_isRegular T j with hj | hj
    · exact hj
    · exact absurd (hj.trans hi.symm) hne

/-! ### Endpoints and endpoint type -/

/-- **Source: `def:one-truss`, lower endpoint `ℓ := 0`. -/
def lower (T : OneTruss) : T.El := ofIdx 0

/-- **Source: `def:one-truss`, upper endpoint `u := n - 1`. -/
def upper (T : OneTruss) : T.El := ofIdx (Fin.last T.len)

@[simp] theorem idx_lower (T : OneTruss) : (idx T.lower).val = 0 := rfl

@[simp] theorem idx_upper (T : OneTruss) : (idx T.upper).val = T.len := rfl

theorem idx_lower_le {T : OneTruss} (i : T.El) : (idx T.lower).val ≤ (idx i).val := by simp

theorem idx_le_upper {T : OneTruss} (i : T.El) : (idx i).val ≤ (idx T.upper).val := by
  simpa using Nat.lt_succ_iff.1 (idx i).isLt

/-- **Source: `Endpoint type` (Chapter 2).**  A 1-truss is *open* if both endpoints are
regular. -/
def IsOpen (T : OneTruss) : Prop := T.IsRegular T.lower ∧ T.IsRegular T.upper

/-- **Source: `Endpoint type` (Chapter 2).**  A 1-truss is *closed* if both endpoints are
singular. -/
def IsClosed (T : OneTruss) : Prop := T.IsSingular T.lower ∧ T.IsSingular T.upper

/-- **Source: `Endpoint type` (Chapter 2).**  A one-element 1-truss is *trivial*. -/
def IsTrivial (T : OneTruss) : Prop := T.len = 0

/-- An open 1-truss has `ε = 1` and an even `len`, i.e. an odd number of carrier elements;
it has `len / 2` singular elements. -/
theorem isOpen_iff (T : OneTruss) : T.IsOpen ↔ T.eps = 1 ∧ T.len % 2 = 0 := by
  have hlo : T.dim T.lower = T.eps := by simp [dim, lower, ofIdx, idx]
  have hup : T.dim T.upper = if T.len % 2 = 0 then T.eps else flip T.eps := by
    simp [dim, upper, ofIdx, idx]
  unfold IsOpen IsRegular
  rw [hlo, hup]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨h1, ?_⟩
    by_contra hmod
    rw [if_neg hmod, h1] at h2
    exact absurd h2 (by decide)
  · rintro ⟨h1, h2⟩
    exact ⟨h1, by rw [if_pos h2]; exact h1⟩

end OneTruss

/-! ### G02: maps of 1-trusses -/

/-- **Source: `def:truss-map` (Chapter 2).**  A map of 1-trusses preserves both the face
order and the frame order.  No dimension-preservation condition is imposed. -/
structure TrussMap (T S : OneTruss) where
  /-- The underlying function on carriers. -/
  toFun : T.El → S.El
  /-- Face monotonicity. -/
  face_monotone : ∀ {i j : T.El}, i ≤ j → toFun i ≤ toFun j
  /-- Frame monotonicity. -/
  frame_monotone : ∀ {i j : T.El}, OneTruss.idx i ≤ OneTruss.idx j →
    OneTruss.idx (toFun i) ≤ OneTruss.idx (toFun j)

namespace TrussMap

open OneTruss

variable {T S R : OneTruss}

instance : CoeFun (TrussMap T S) (fun _ => T.El → S.El) := ⟨TrussMap.toFun⟩

@[ext] theorem ext {q r : TrussMap T S} (h : ∀ i, q i = r i) : q = r := by
  cases q; cases r; congr 1; exact funext h

/-- **Source: `lem:Identity and composition of 1-truss maps`.** -/
def id (T : OneTruss) : TrussMap T T where
  toFun := _root_.id
  face_monotone h := h
  frame_monotone h := h

/-- **Source: `lem:Identity and composition of 1-truss maps`.** -/
def comp (r : TrussMap S R) (q : TrussMap T S) : TrussMap T R where
  toFun := r.toFun ∘ q.toFun
  face_monotone h := r.face_monotone (q.face_monotone h)
  frame_monotone h := r.frame_monotone (q.frame_monotone h)

@[simp] theorem id_apply (T : OneTruss) (i : T.El) : TrussMap.id T i = i := rfl

@[simp] theorem comp_apply (r : TrussMap S R) (q : TrussMap T S) (i : T.El) :
    r.comp q i = r (q i) := rfl

theorem comp_assoc {W : OneTruss} (s : TrussMap R W) (r : TrussMap S R) (q : TrussMap T S) :
    (s.comp r).comp q = s.comp (r.comp q) := rfl

@[simp] theorem id_comp (q : TrussMap T S) : (TrussMap.id S).comp q = q := rfl

@[simp] theorem comp_id (q : TrussMap T S) : q.comp (TrussMap.id T) = q := rfl

/-- Frame monotonicity in terms of the underlying natural-number indices. -/
theorem idx_mono (q : TrussMap T S) {i j : T.El} (h : (idx i).val ≤ (idx j).val) :
    (idx (q i)).val ≤ (idx (q j)).val := q.frame_monotone h

/-- The image of an adjacent pair advances by at most one frame step.  This is the chapter's
"consecutive elements are face-comparable, so their images are face-comparable, and distinct
face-comparable elements of `S` are adjacent in frame order". -/
theorem idx_step (q : TrussMap T S) {i j : T.El} (h : (idx j).val = (idx i).val + 1) :
    (idx (q j)).val ≤ (idx (q i)).val + 1 := by
  have hcomp : q i ≤ q j ∨ q j ≤ q i := by
    rcases faceComparable_of_succ T h with hc | hc
    · exact Or.inl (q.face_monotone hc)
    · exact Or.inr (q.face_monotone hc)
  have := idx_dist_le_one hcomp
  omega

end TrussMap

/-! ### G03: the endpoint criterion for surjectivity -/

namespace TrussMap

open OneTruss

variable {T S : OneTruss}

/-- A map of 1-trusses sends the lower endpoint to the least frame coordinate of its image,
and the upper endpoint to the greatest. -/
theorem idx_map_lower_le (q : TrussMap T S) (i : T.El) :
    (idx (q T.lower)).val ≤ (idx (q i)).val := q.idx_mono (by simp)

theorem idx_map_le_upper (q : TrussMap T S) (i : T.El) :
    (idx (q i)).val ≤ (idx (q T.upper)).val := q.idx_mono (idx_le_upper i)

/-- A discrete intermediate-value lemma: a sequence of naturals that increases by at most one
at each step attains every value between `f 0` and `f N`. -/
private theorem exists_eq_of_step {f : ℕ → ℕ} (hstep : ∀ k, f (k + 1) ≤ f k + 1) {N m : ℕ}
    (hlo : f 0 ≤ m) (hhi : m ≤ f N) : ∃ k ≤ N, f k = m := by
  induction N with
  | zero => exact ⟨0, le_rfl, le_antisymm hlo hhi⟩
  | succ N ih =>
      by_cases h : m ≤ f N
      · obtain ⟨k, hk, hfk⟩ := ih h
        exact ⟨k, hk.trans (Nat.le_succ N), hfk⟩
      · have hs := hstep N
        exact ⟨N + 1, le_rfl, by omega⟩

/-- The frame coordinate of the image of the `k`-th element of `T`, clamped to the carrier. -/
private def walk (q : TrussMap T S) (k : ℕ) : ℕ :=
  (idx (q (ofIdx ⟨min k T.len, Nat.lt_succ_of_le (Nat.min_le_right _ _)⟩))).val

private theorem walk_zero (q : TrussMap T S) : walk q 0 = (idx (q T.lower)).val := rfl

private theorem walk_len (q : TrussMap T S) : walk q T.len = (idx (q T.upper)).val := by
  unfold walk upper ofIdx
  have : (⟨min T.len T.len, Nat.lt_succ_of_le (Nat.min_le_right _ _)⟩ : Fin (T.len + 1))
      = Fin.last T.len := Fin.ext (by simp)
  rw [this]

private theorem walk_step (q : TrussMap T S) (k : ℕ) : walk q (k + 1) ≤ walk q k + 1 := by
  rcases lt_or_ge k T.len with hk | hk
  · have h1 : min k T.len = k := Nat.min_eq_left hk.le
    have h2 : min (k + 1) T.len = k + 1 := Nat.min_eq_left hk
    simp only [walk, h1, h2]
    exact q.idx_step (i := ofIdx ⟨k, Nat.lt_succ_of_le hk.le⟩)
      (j := ofIdx ⟨k + 1, Nat.lt_succ_of_le hk⟩) rfl
  · have h1 : min k T.len = T.len := Nat.min_eq_right hk
    have h2 : min (k + 1) T.len = T.len := Nat.min_eq_right (hk.trans (Nat.le_succ k))
    simp only [walk, h1, h2]
    omega

/-- Every frame coordinate between `q(ℓ_T)` and `q(u_T)` is attained: a sequence that starts
at `q(ℓ_T)`, increases by at most one at each frame step and ends at `q(u_T)` takes every
intermediate value.  This is the counting step of `lem:truss-map-surjective-iff-endpoints`. -/
theorem exists_idx_eq (q : TrussMap T S) {m : ℕ} (hlo : (idx (q T.lower)).val ≤ m)
    (hhi : m ≤ (idx (q T.upper)).val) : ∃ i : T.El, (idx (q i)).val = m := by
  have h0 : walk q 0 ≤ m := by rw [walk_zero]; exact hlo
  have hN : m ≤ walk q T.len := by rw [walk_len]; exact hhi
  obtain ⟨k, -, hk⟩ := exists_eq_of_step (f := walk q) (walk_step q) h0 hN
  exact ⟨ofIdx ⟨min k T.len, Nat.lt_succ_of_le (Nat.min_le_right _ _)⟩, hk⟩

/-- **Source: `lem:truss-map-surjective-iff-endpoints` (Chapter 2), G03.**
A map of 1-trusses is surjective if and only if it preserves both endpoints.

This holds for **all** 1-trusses, in every endpoint regime, and carries no
regular-preservation hypothesis. -/
theorem surjective_iff_endpoints (q : TrussMap T S) :
    Function.Surjective q.toFun ↔ q T.lower = S.lower ∧ q T.upper = S.upper := by
  constructor
  · intro hsurj
    constructor
    · obtain ⟨i, hi⟩ := hsurj S.lower
      refine idx_injective (Fin.ext ?_)
      have h1 : (idx (q T.lower)).val ≤ (idx (q i)).val := q.idx_map_lower_le i
      rw [hi] at h1
      simpa using Nat.le_antisymm h1 (Nat.zero_le _)
    · obtain ⟨i, hi⟩ := hsurj S.upper
      refine idx_injective (Fin.ext ?_)
      have h1 : (idx (q i)).val ≤ (idx (q T.upper)).val := q.idx_map_le_upper i
      rw [hi] at h1
      exact Nat.le_antisymm (idx_le_upper _) h1
  · rintro ⟨hl, hu⟩ s
    obtain ⟨i, hi⟩ := q.exists_idx_eq (m := (idx s).val)
      (by rw [hl]; simp) (by rw [hu]; simpa using idx_le_upper s)
    exact ⟨i, idx_injective (Fin.ext hi)⟩

end TrussMap

end Truss.Transfer.Geometry
